{
  "expo": {
    "name": "Bekofy",
    "slug": "bekofy",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bekofy",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#080E0A",
    "ios": {
      "bundleIdentifier": "com.bekofy.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.bekofy.app",
      "versionCode": 20000,
      "adaptiveIcon": {
        "backgroundColor": "#080E0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080E0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#080E0A",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Çalma listene kapak seçmek için fotoğraflarına erişmek istiyoruz.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "./plugins/with-cmake-object-path-max",
      "./plugins/with-release-signing",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/00beddde-51a9-49f0-b469-541987dac903",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "eas": {
        "projectId": "00beddde-51a9-49f0-b469-541987dac903"
      }
    },
    "owner": "tikzi"
  }
}
