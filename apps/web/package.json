{
  "name": "@bekofy/web",
  "version": "0.1.0",
  "private": true,
  "description": "Bekofy sitesi: tanıtım ve indirme, hesap, Premium, sanatçı paneli, admin paneli",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @bekofy/tokens",
    "dev": "next dev -p 3000",
    "prebuild": "npm run build -w @bekofy/tokens",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "node scripts/check.mjs",
    "check:auth": "node scripts/check-auth.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/s3-request-presigner": "3.1148.0",
    "@bekofy/brand": "*",
    "@bekofy/core": "*",
    "@bekofy/tokens": "*",
    "@bekofy/ui": "*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
