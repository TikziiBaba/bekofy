# ÖRNEK DOSYA: git'e girer, gerçek değerleri buraya YAZMA.
# Yerelde: bu dosyayı apps/web/.env.local olarak kopyala ve doldur. Vercel'de: Project Settings > Environment Variables.

# Sitenin genel adresi (sitemap, Open Graph, e-posta bağlantıları).
NEXT_PUBLIC_SITE_URL=https://bekofy.bekirr.dev

# Sanatçı yüklemeleri ve admin silme işlemleri için R2. Yalnızca sunucuda okunur, tarayıcıya gitmez.
# Cloudflare panelinde: R2 > Manage R2 API Tokens. İzin: "Object Read & Write", yalnızca aşağıdaki bucket.
R2_ACCOUNT_ID=cloudflare-hesap-kimligi
R2_ACCESS_KEY_ID=r2-erisim-anahtari
R2_SECRET_ACCESS_KEY=r2-gizli-anahtar
R2_BUCKET_NAME=bekofy-music
R2_PUBLIC_DOMAIN=music.bekirr.dev
