{
  "name": "@bekofy/yt-server",
  "version": "0.1.0",
  "private": true,
  "description": "Bekofy yerel YouTube içe aktarma sunucusu: admin panelinden gelen bağlantıyı indirir, R2'ye yükler, kütüphaneye ekler",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "setup": "node scripts/setup.mjs",
    "update": "node scripts/setup.mjs --update",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/lib-storage": "3.1148.0",
    "@bekofy/core": "*",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
