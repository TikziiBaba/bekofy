# ÖRNEK DOSYA: git'e girer, gerçek değerleri buraya YAZMA.
# Gerçek değerler kökteki .env dosyasına (R2_ ile başlayanlar okunur) ya da bu klasörde .env adlı dosyaya yazılır.
# Supabase anahtarı GEREKMEZ: şarkı kaydı admin panelindeki oturumla yapılır.

# Cloudflare panelinde: R2 > Manage R2 API Tokens > Create API Token
# İzin: "Object Read & Write", yalnızca aşağıdaki bucket için.
R2_ACCOUNT_ID=cloudflare-hesap-kimligi
R2_ACCESS_KEY_ID=r2-erisim-anahtari
R2_SECRET_ACCESS_KEY=r2-gizli-anahtar
R2_BUCKET_NAME=bekofy-music
# Dosyaların herkese açık adresi (mevcut şarkılar bu alandan çalıyor).
R2_PUBLIC_DOMAIN=music.bekirr.dev

# İsteğe bağlı. Sunucu yalnızca 127.0.0.1 üzerinde dinler.
PORT=4317
# Admin panelinin çalıştığı adresler (virgülle). Başka adreslerden gelen istekler reddedilir.
ALLOWED_ORIGINS=https://bekofy.bekirr.dev,http://localhost:3000,http://localhost:4400
