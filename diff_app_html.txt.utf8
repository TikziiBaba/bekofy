+  <script>
+    // Android/Capacitor: masa├╝st├╝ titlebar'─▒ gizle ve layout'u d├╝zelt
+    if (window.Capacitor || document.URL.startsWith('https://localhost') || document.URL.indexOf('capacitor') !== -1) {
+      var tb = document.getElementById('titlebar');
+      if (tb) tb.style.display = 'none';
+      // Titlebar y├╝ksekli─şini kald─▒r
+      document.documentElement.style.setProperty('--titlebar-height', '0px');
+      // Body ve sidebar'─▒n ├╝st bo┼şlu─şunu kald─▒r
+      document.body.style.paddingTop = '0';
+      var sidebar = document.querySelector('.sidebar');
+      if (sidebar) sidebar.style.top = '0';
+      var topBar = document.getElementById('top-bar');
+      if (topBar) topBar.style.top = '0';
+      var mainContent = document.querySelector('.main-content');
+      if (mainContent) mainContent.style.top = '0';
+    }
+  </script>
