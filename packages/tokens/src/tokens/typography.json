{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Bricolage Grotesque", "Geist", "system-ui", "sans-serif"], "$description": "Başlıklar, logo yazısı, Wrapped. Gövde metninde kullanılmaz." },
      "ui": { "$value": ["Geist", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "mono": { "$value": ["Geist Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Major Third (1.25) ölçeği.",
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "base": { "$value": "16px" },
      "lg": { "$value": "18px" },
      "xl": { "$value": "20px" },
      "2xl": { "$value": "24px" },
      "3xl": { "$value": "30px" },
      "4xl": { "$value": "36px" },
      "5xl": { "$value": "48px" },
      "6xl": { "$value": "60px" },
      "7xl": { "$value": "72px" }
    },
    "lineHeight": {
      "$type": "number",
      "display": { "$value": 1.05 },
      "tight": { "$value": 1.15 },
      "snug": { "$value": 1.3 },
      "normal": { "$value": 1.5 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "display": { "$value": "-0.03em" },
      "tight": { "$value": "-0.015em" },
      "normal": { "$value": "0em" }
    }
  },
  "text": {
    "$type": "typography",
    "display": {
      "xl": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.7xl}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.lineHeight.display}", "letterSpacing": "{font.letterSpacing.display}" } },
      "lg": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.5xl}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.lineHeight.display}", "letterSpacing": "{font.letterSpacing.display}" } }
    },
    "title": {
      "xl": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.4xl}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.lineHeight.tight}", "letterSpacing": "{font.letterSpacing.tight}" } },
      "lg": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.2xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.lineHeight.snug}", "letterSpacing": "{font.letterSpacing.tight}" } },
      "md": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.lineHeight.snug}", "letterSpacing": "{font.letterSpacing.tight}" } },
      "sm": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.lg}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.lineHeight.snug}", "letterSpacing": "{font.letterSpacing.normal}" } }
    },
    "body": {
      "lg": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.lg}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.normal}", "letterSpacing": "{font.letterSpacing.normal}" } },
      "md": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.base}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.normal}", "letterSpacing": "{font.letterSpacing.normal}" } },
      "sm": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.normal}", "letterSpacing": "{font.letterSpacing.normal}" } }
    },
    "label": {
      "md": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.lineHeight.snug}", "letterSpacing": "{font.letterSpacing.normal}" } },
      "sm": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.xs}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.lineHeight.snug}", "letterSpacing": "{font.letterSpacing.normal}" } }
    },
    "caption": { "$value": { "fontFamily": "{font.family.ui}", "fontSize": "{font.size.xs}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.normal}", "letterSpacing": "{font.letterSpacing.normal}" } },
    "mono": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "{font.size.sm}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.normal}", "letterSpacing": "{font.letterSpacing.normal}" } }
  }
}
