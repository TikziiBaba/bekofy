{
  "name": "bekofy",
  "version": "1.4.0",
  "description": "Bekofy - Spotify benzeri masaüstü müzik uygulaması",
  "main": "main.js",
  "scripts": {
    "start": "concurrently --names \"electron,website\" --prefix-colors \"cyan,green\" \"electron .\" \"serve website -l 3333\"",
    "start:electron": "electron .",
    "start:website": "serve website -l 3333",
    "build": "electron-builder --win",
    "dev": "electron . --dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "author": "Bekir",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/lib-storage": "^3.1085.0",
    "@supabase/supabase-js": "^2.100.1",
    "discord-rpc": "^4.0.1",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "ngrok": "^5.0.0-beta.2",
    "stylelint-config-standard": "^40.0.0",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-languageserver-types": "^3.17.5",
    "youtube-dl-exec": "^3.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "jest": "^29.7.0",
    "serve": "^14.2.6"
  }
}
